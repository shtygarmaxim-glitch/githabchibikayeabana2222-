{
  "name": "tma-gaming-platform",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "cd client && npm install",
    "build:client": "cd client && npm run build",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "npx prisma generate && npm run build:server && npm run build:client",
    "start": "node server/dist/index.js",
    "dev": "node --watch server/src/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5",
    "@types/ws": "^8.5.12",
    "prisma": "^5.19.1",
    "typescript": "^5.6.2"
  }
}
