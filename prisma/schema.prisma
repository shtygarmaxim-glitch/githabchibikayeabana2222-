datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  telegramId   String        @unique
  username     String?
  firstName    String?
  balance      Decimal       @default(1000.00) @db.Decimal(12, 2)
  createdAt    DateTime      @default(now())

  transactions Transaction[]
  gameSessions GameSession[]
  crashBets    CrashBet[]
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  type      String
  createdAt DateTime @default(now())
}

model GameSession {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game       String
  bet        Decimal  @db.Decimal(12, 2)
  multiplier Decimal? @db.Decimal(8, 2)
  payout     Decimal? @db.Decimal(12, 2)
  status     String   @default("ACTIVE")
  stateData  Json
  createdAt  DateTime @default(now())
}

model CrashRound {
  id         String     @id @default(uuid())
  crashPoint Decimal    @db.Decimal(8, 2)
  hash       String
  isFinished Boolean    @default(false)
  startedAt  DateTime   @default(now())

  bets       CrashBet[]
}

model CrashBet {
  id        String     @id @default(uuid())
  roundId   String
  userId    String
  amount    Decimal    @db.Decimal(12, 2)
  cashout   Decimal?   @db.Decimal(8, 2)
  payout    Decimal?   @db.Decimal(12, 2)
  isWon     Boolean    @default(false)

  round     CrashRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}
